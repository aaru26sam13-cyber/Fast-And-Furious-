package com.fastandfurious.app;

import android.Manifest;
import android.app.Activity;
import android.content.ComponentName;
import android.content.Context;
import android.content.Intent;
import android.content.SharedPreferences;
import android.content.pm.PackageManager;
import android.graphics.Color;
import android.graphics.Typeface;
import android.graphics.drawable.GradientDrawable;
import android.net.Uri;
import android.os.Build;
import android.os.Bundle;
import android.os.PowerManager;
import android.provider.Settings;
import android.view.Gravity;
import android.view.View;
import android.widget.*;

import androidx.appcompat.app.AppCompatActivity;

import rikka.shizuku.Shizuku;

public class MainActivity extends AppCompatActivity {

    LinearLayout root;
    LinearLayout content;

    SharedPreferences prefs;

    final int BG = Color.rgb(246, 248, 253);
    final int WHITE = Color.WHITE;
    final int DARK = Color.rgb(25, 32, 48);
    final int MUTED = Color.rgb(105, 114, 132);

    final int BLUE = Color.rgb(50, 105, 220);
    final int PURPLE = Color.rgb(112, 76, 190);
    final int GREEN = Color.rgb(25, 145, 92);
    final int ORANGE = Color.rgb(220, 125, 35);
    final int RED = Color.rgb(205, 55, 65);

    final int LIGHT_BLUE = Color.rgb(238, 245, 255);
    final int LIGHT_PURPLE = Color.rgb(246, 240, 255);
    final int LIGHT_GREEN = Color.rgb(237, 250, 243);
    final int LIGHT_ORANGE = Color.rgb(255, 246, 235);

    TextView accessibilityStatus;
    TextView notificationStatus;
    TextView batteryStatus;
    TextView shizukuStatus;

    static final int SHIZUKU_PERMISSION_CODE = 4001;

    @Override
    protected void onCreate(Bundle savedInstanceState) {
        super.onCreate(savedInstanceState);

        prefs = getSharedPreferences("fast_furious", MODE_PRIVATE);

        try {
            Shizuku.addBinderReceivedListenerSticky(
                    () -> runOnUiThread(this::refreshStatuses)
            );

            Shizuku.addBinderDeadListener(
                    () -> runOnUiThread(this::refreshStatuses)
            );

            Shizuku.addRequestPermissionResultListener(
                    (requestCode, grantResult) ->
                            runOnUiThread(this::refreshStatuses)
            );
        } catch (Throwable ignored) {}

        showHome();
    }

    @Override
    protected void onResume() {
        super.onResume();
        refreshStatuses();
    }

    // ============================================================
    // HELPERS
    // ============================================================

    int dp(int v) {
        return (int) (
                v * getResources().getDisplayMetrics().density + 0.5f
        );
    }

    TextView text(String value, float size, boolean bold) {
        TextView t = new TextView(this);
        t.setText(value);
        t.setTextSize(size);
        t.setTextColor(DARK);
        t.setTypeface(
                Typeface.DEFAULT,
                bold ? Typeface.BOLD : Typeface.NORMAL
        );
        t.setGravity(Gravity.CENTER_VERTICAL);
        return t;
    }

    TextView muted(String value) {
        TextView t = text(value, 13, false);
        t.setTextColor(MUTED);
        return t;
    }

    GradientDrawable rounded(
            int fill,
            int stroke,
            int radius
    ) {
        GradientDrawable g = new GradientDrawable();
        g.setColor(fill);
        g.setCornerRadius(dp(radius));
        g.setStroke(dp(1), stroke);
        return g;
    }

    GradientDrawable buttonBg(int color) {
        GradientDrawable g = new GradientDrawable();
        g.setColor(color);
        g.setCornerRadius(dp(14));
        return g;
    }

    LinearLayout card(int borderColor) {

        LinearLayout c = new LinearLayout(this);
        c.setOrientation(LinearLayout.VERTICAL);

        c.setPadding(
                dp(18),
                dp(16),
                dp(18),
                dp(16)
        );

        c.setBackground(
                rounded(
                        WHITE,
                        borderColor,
                        20
                )
        );

        LinearLayout.LayoutParams lp =
                new LinearLayout.LayoutParams(
                        -1,
                        -2
                );

        lp.setMargins(
                0,
                dp(7),
                0,
                dp(7)
        );

        c.setLayoutParams(lp);

        return c;
    }

    TextView title(String icon, String name) {

        TextView t = text(
                icon + "  " + name,
                19,
                true
        );

        t.setPadding(
                0,
                0,
                0,
                dp(9)
        );

        return t;
    }

    Button primary(String value, int color) {

        Button b = new Button(this);

        b.setText(value);
        b.setTextSize(13);
        b.setTextColor(Color.WHITE);
        b.setTypeface(
                Typeface.DEFAULT,
                Typeface.BOLD
        );

        b.setAllCaps(false);
        b.setGravity(Gravity.CENTER);

        b.setBackground(
                buttonBg(color)
        );

        LinearLayout.LayoutParams lp =
                new LinearLayout.LayoutParams(
                        -1,
                        dp(48)
                );

        lp.setMargins(
                0,
                dp(9),
                0,
                0
        );

        b.setLayoutParams(lp);

        return b;
    }

    Button secondary(
            String value,
            int color,
            int light
    ) {

        Button b = new Button(this);

        b.setText(value);
        b.setTextSize(13);
        b.setTextColor(color);
        b.setTypeface(
                Typeface.DEFAULT,
                Typeface.BOLD
        );

        b.setAllCaps(false);
        b.setGravity(Gravity.CENTER);

        b.setBackground(
                rounded(
                        light,
                        color,
                        14
                )
        );

        LinearLayout.LayoutParams lp =
                new LinearLayout.LayoutParams(
                        -1,
                        dp(46)
                );

        lp.setMargins(
                0,
                dp(9),
                0,
                0
        );

        b.setLayoutParams(lp);

        return b;
    }

    // ============================================================
    // PAGE BASE
    // ============================================================

    void base(
            String pageTitle,
            String subtitle,
            int pageColor
    ) {

        root = new LinearLayout(this);
        root.setOrientation(
                LinearLayout.VERTICAL
        );

        root.setPadding(
                dp(5),
                dp(5),
                dp(5),
                0
        );

        root.setBackground(
                rounded(
                        BG,
                        pageColor,
                        18
                )
        );

        LinearLayout header =
                new LinearLayout(this);

        header.setOrientation(
                LinearLayout.VERTICAL
        );

        header.setPadding(
                dp(20),
                dp(19),
                dp(20),
                dp(8)
        );

        TextView h =
                text(
                        pageTitle,
                        27,
                        true
                );

        h.setTextColor(DARK);

        header.addView(h);

        if (subtitle != null) {

            TextView sub =
                    muted(subtitle);

            sub.setTextSize(14);

            header.addView(sub);
        }

        root.addView(header);

        content =
                new LinearLayout(this);

        content.setOrientation(
                LinearLayout.VERTICAL
        );

        content.setPadding(
                dp(14),
                dp(5),
                dp(14),
                dp(14)
        );

        ScrollView scroll =
                new ScrollView(this);

        scroll.setFillViewport(true);
        scroll.addView(content);

        root.addView(
                scroll,
                new LinearLayout.LayoutParams(
                        -1,
                        0,
                        1
                )
        );

        bottomMenu();

        setContentView(root);
    }

    // ============================================================
    // BOTTOM NAV
    // ============================================================

    void bottomMenu() {

        LinearLayout menu =
                new LinearLayout(this);

        menu.setGravity(Gravity.CENTER);
        menu.setPadding(
                dp(5),
                dp(5),
                dp(5),
                dp(5)
        );

        menu.setBackgroundColor(WHITE);

        String[][] items = {
                {"⌂", "Home"},
                {"⚙", "Settings"},
                {"⚡", "Auto"},
                {"♙", "Profile"}
        };

        for (String[] item : items) {

            LinearLayout box =
                    new LinearLayout(this);

            box.setOrientation(
                    LinearLayout.VERTICAL
            );

            box.setGravity(
                    Gravity.CENTER
            );

            TextView icon =
                    text(
                            item[0],
                            21,
                            true
                    );

            icon.setGravity(
                    Gravity.CENTER
            );

            TextView label =
                    text(
                            item[1],
                            11,
                            true
                    );

            label.setTextColor(MUTED);
            label.setGravity(
                    Gravity.CENTER
            );

            box.addView(icon);
            box.addView(label);

            box.setOnClickListener(v -> {

                if (item[1].equals("Home"))
                    showHome();

                if (item[1].equals("Settings"))
                    showSettings();

                if (item[1].equals("Auto"))
                    showAutoService();

                if (item[1].equals("Profile"))
                    showProfile();
            });

            menu.addView(
                    box,
                    new LinearLayout.LayoutParams(
                            0,
                            dp(66),
                            1
                    )
            );
        }

        root.addView(menu);
    }

    // ============================================================
    // HOME
    // ============================================================

    void showHome() {

        base(
                "Fast And Furious",
                "Your smart ride dashboard",
                BLUE
        );

        LinearLayout welcome =
                card(BLUE);

        welcome.addView(
                text(
                        "Welcome 👋",
                        26,
                        true
                )
        );

        welcome.addView(
                muted(
                        "Manage your ride preferences easily."
                )
        );

        content.addView(welcome);

        Button history =
                primary(
                        "🚗  RIDE HISTORY",
                        BLUE
                );

        history.setOnClickListener(
                v -> showHistory()
        );

        content.addView(history);

        Button settings =
                secondary(
                        "⚙  RIDE SETTINGS",
                        BLUE,
                        LIGHT_BLUE
                );

        settings.setOnClickListener(
                v -> showSettings()
        );

        content.addView(settings);

        LinearLayout status =
                card(BLUE);

        status.addView(
                title(
                        "⚡",
                        "Service Status"
                )
        );

        TextView s =
                text(
                        "Auto Service: " +
                                (prefs.getBoolean(
                                        "auto_service",
                                        false
                                ) ? "ON" : "OFF"),
                        16,
                        true
                );

        status.addView(s);

        content.addView(status);
    }

    // ============================================================
    // SETTINGS
    // ============================================================

    void showSettings() {

        base(
                "Settings",
                "Permissions, ride apps & preferences",
                PURPLE
        );

        // --------------------------------------------------------
        // PERMISSIONS
        // --------------------------------------------------------

        LinearLayout permission =
                card(PURPLE);

        permission.addView(
                title(
                        "🔐",
                        "Permissions & Services"
                )
        );

        permission.addView(
                muted(
                        "Keep required Android services enabled."
                )
        );

        accessibilityStatus =
                statusRow(
                        permission,
                        "♿",
                        "Accessibility Service"
                );

        Button accessibility =
                secondary(
                        "OPEN ACCESSIBILITY SETTINGS",
                        PURPLE,
                        LIGHT_PURPLE
                );

        accessibility.setOnClickListener(
                v -> openAccessibility()
        );

        permission.addView(accessibility);

        notificationStatus =
                statusRow(
                        permission,
                        "🔔",
                        "Notification Permission"
                );

        Button notification =
                secondary(
                        "ALLOW / OPEN NOTIFICATIONS",
                        PURPLE,
                        LIGHT_PURPLE
                );

        notification.setOnClickListener(
                v -> openNotification()
        );

        permission.addView(notification);

        batteryStatus =
                statusRow(
                        permission,
                        "🔋",
                        "Battery"
                );

        Button battery =
                secondary(
                        "OPEN BATTERY SETTINGS",
                        PURPLE,
                        LIGHT_PURPLE
                );

        battery.setOnClickListener(
                v -> openBattery()
        );

        permission.addView(battery);

        shizukuStatus =
                statusRow(
                        permission,
                        "🛡️",
                        "Shizuku"
                );

        Button shizuku =
                primary(
                        "CONNECT / REQUEST SHIZUKU",
                        PURPLE
                );

        shizuku.setOnClickListener(
                v -> shizukuAction()
        );

        permission.addView(shizuku);

        Button shizukuOpen =
                secondary(
                        "OPEN SHIZUKU APP",
                        PURPLE,
                        LIGHT_PURPLE
                );

        shizukuOpen.setOnClickListener(
                v -> openShizuku()
        );

        permission.addView(shizukuOpen);

        content.addView(permission);

        // --------------------------------------------------------
        // RIDE APPS
        // --------------------------------------------------------

        LinearLayout apps =
                card(GREEN);

        apps.addView(
                title(
                        "🚕",
                        "Ride Apps"
                )
        );

        apps.addView(
                muted(
                        "Choose which ride apps are enabled."
                )
        );

        addAppSwitch(
                apps,
                "🟢",
                "Ola",
                "ola",
                GREEN,
                LIGHT_GREEN
        );

        addAppSwitch(
                apps,
                "🚗",
                "Uber",
                "uber",
                BLUE,
                LIGHT_BLUE
        );

        addAppSwitch(
                apps,
                "🏍️",
                "Rapido",
                "rapido",
                ORANGE,
                LIGHT_ORANGE
        );

        content.addView(apps);

        // --------------------------------------------------------
        // FARE
        // --------------------------------------------------------

        LinearLayout fare =
                card(ORANGE);

        fare.addView(
                title(
                        "💰",
                        "Fare Filter"
                )
        );

        EditText min =
                input(
                        "Minimum Fare ₹"
                );

        fare.addView(
                withMargin(min, 5, 5)
        );

        EditText max =
                input(
                        "Maximum Fare ₹"
                );

        fare.addView(
                withMargin(max, 12, 5)
        );

        content.addView(fare);

        // --------------------------------------------------------
        // LOCATION
        // --------------------------------------------------------

        addLocationSection();

        // --------------------------------------------------------
        // AVOID LOCATION
        // --------------------------------------------------------

        addAvoidSection();

        // --------------------------------------------------------
        // HELP
        // --------------------------------------------------------

        LinearLayout help =
                card(BLUE);

        help.addView(
                title(
                        "❓",
                        "Setup Help"
                )
        );

        help.addView(
                muted(
                        "1. Turn ON Accessibility Service.\n\n" +
                        "2. Allow Notification permission.\n\n" +
                        "3. Set Battery to Unrestricted.\n\n" +
                        "4. Start Shizuku and authorize this app.\n\n" +
                        "5. Return here to see the live status."
                )
        );

        content.addView(help);
    }

    // ============================================================
    // RIDE APP SWITCH
    // ============================================================

    void addAppSwitch(
            LinearLayout parent,
            String icon,
            String name,
            String key,
            int color,
            int light
    ) {

        LinearLayout row =
                new LinearLayout(this);

        row.setGravity(
                Gravity.CENTER_VERTICAL
        );

        row.setPadding(
                dp(12),
                dp(12),
                dp(8),
                dp(12)
        );

        row.setBackground(
                rounded(
                        light,
                        color,
                        14
                )
        );

        TextView label =
                text(
                        icon + "  " + name,
                        17,
                        true
                );

        row.addView(
                label,
                new LinearLayout.LayoutParams(
                        0,
                        dp(58),
                        1
                )
        );

        Switch sw =
                new Switch(this);

        sw.setChecked(
                prefs.getBoolean(
                        "app_" + key,
                        true
                )
        );

        sw.setOnCheckedChangeListener(
                (buttonView, checked) ->
                        prefs.edit()
                                .putBoolean(
                                        "app_" + key,
                                        checked
                                )
                                .apply()
        );

        row.addView(
                sw,
                new LinearLayout.LayoutParams(
                        dp(70),
                        dp(58)
                )
        );

        LinearLayout.LayoutParams lp =
                new LinearLayout.LayoutParams(
                        -1,
                        dp(76)
                );

        lp.setMargins(
                0,
                dp(8),
                0,
                dp(2)
        );

        parent.addView(
                row,
                lp
        );
    }

    // ============================================================
    // INPUT
    // ============================================================

    EditText input(String hint) {

        EditText e =
                new EditText(this);

        e.setHint(hint);
        e.setTextSize(16);
        e.setSingleLine(true);

        e.setPadding(
                dp(14),
                0,
                dp(14),
                0
        );

        e.setBackground(
                rounded(
                        Color.rgb(250,251,254),
                        Color.rgb(210,216,230),
                        13
                )
        );

        return e;
    }

    View withMargin(
            View v,
            int top,
            int bottom
    ) {

        LinearLayout.LayoutParams lp =
                new LinearLayout.LayoutParams(
                        -1,
                        dp(52)
                );

        lp.setMargins(
                0,
                dp(top),
                0,
                dp(bottom)
        );

        v.setLayoutParams(lp);

        return v;
    }

    // ============================================================
    // LOCATION SECTION
    // ============================================================

    void addLocationSection() {

        LinearLayout card =
                card(BLUE);

        card.addView(
                title(
                        "📍",
                        "Location Filter"
                )
        );

        Switch filter =
                new Switch(this);

        filter.setText(
                "Location Filter ON / OFF"
        );

        filter.setTextSize(16);

        filter.setChecked(
                prefs.getBoolean(
                        "location_filter",
                        false
                )
        );

        filter.setOnCheckedChangeListener(
                (b, checked) ->
                        prefs.edit()
                                .putBoolean(
                                        "location_filter",
                                        checked
                                )
                                .apply()
        );

        card.addView(
                withMargin(
                        filter,
                        2,
                        4
                )
        );

        Button add =
                secondary(
                        "+  ADD LOCATION",
                        BLUE,
                        LIGHT_BLUE
                );

        card.addView(add);

        TextView limit =
                muted(
                        "Maximum 25 saved locations"
                );

        limit.setPadding(
                dp(5),
                dp(12),
                dp(5),
                dp(3)
        );

        card.addView(limit);

        add.setOnClickListener(v -> {

            EditText input =
                    input(
                            "Enter location name"
                    );

            Button save =
                    primary(
                            "SAVE LOCATION",
                            BLUE
                    );

            card.addView(
                    input,
                    card.indexOfChild(limit)
            );

            card.addView(
                    save,
                    card.indexOfChild(limit)
            );

            input.requestFocus();

            save.setOnClickListener(x -> {

                String value =
                        input.getText()
                                .toString()
                                .trim();

                if (value.isEmpty()) {
                    input.setError(
                            "Enter a location"
                    );
                    return;
                }

                TextView saved =
                        text(
                                "📍  " + value,
                                15,
                                true
                        );

                saved.setPadding(
                        dp(14),
                        dp(13),
                        dp(14),
                        dp(13)
                );

                saved.setBackground(
                        rounded(
                                LIGHT_BLUE,
                                BLUE,
                                13
                        )
                );

                card.addView(
                        saved,
                        card.indexOfChild(limit)
                );

                Button remove =
                        secondary(
                                "REMOVE",
                                RED,
                                Color.rgb(
                                        255,
                                        240,
                                        242
                                )
                        );

                card.addView(
                        remove,
                        card.indexOfChild(limit)
                );

                remove.setOnClickListener(
                        z -> {
                            card.removeView(saved);
                            card.removeView(remove);
                        }
                );

                card.removeView(input);
                card.removeView(save);
            });
        });

        content.addView(card);
    }

    // ============================================================
    // AVOID LOCATION
    // ============================================================

    void addAvoidSection() {

        LinearLayout card =
                card(RED);

        card.addView(
                title(
                        "🚫",
                        "Avoid Location"
                )
        );

        Switch avoid =
                new Switch(this);

        avoid.setText(
                "Avoid Location ON / OFF"
        );

        avoid.setTextSize(16);

        avoid.setChecked(
                prefs.getBoolean(
                        "avoid_location",
                        false
                )
        );

        avoid.setOnCheckedChangeListener(
                (b, checked) ->
                        prefs.edit()
                                .putBoolean(
                                        "avoid_location",
                                        checked
                                )
                                .apply()
        );

        card.addView(
                withMargin(
                        avoid,
                        2,
                        4
                )
        );

        Button add =
                secondary(
                        "+  ADD AVOID LOCATION",
                        RED,
                        Color.rgb(
                                255,
                                240,
                                242
                        )
                );

        card.addView(add);

        TextView limit =
                muted(
                        "Maximum 10 saved locations"
                );

        limit.setPadding(
                dp(5),
                dp(12),
                dp(5),
                dp(3)
        );

        card.addView(limit);

        add.setOnClickListener(v -> {

            EditText input =
                    input(
                            "Enter avoid location"
                    );

            Button save =
                    primary(
                            "SAVE AVOID LOCATION",
                            RED
                    );

            card.addView(
                    input,
                    card.indexOfChild(limit)
            );

            card.addView(
                    save,
                    card.indexOfChild(limit)
            );

            input.requestFocus();

            save.setOnClickListener(x -> {

                String value =
                        input.getText()
                                .toString()
                                .trim();

                if (value.isEmpty()) {
                    input.setError(
                            "Enter a location"
                    );
                    return;
                }

                TextView saved =
                        text(
                                "🚫  " + value,
                                15,
                                true
                        );

                saved.setPadding(
                        dp(14),
                        dp(13),
                        dp(14),
                        dp(13)
                );

                saved.setBackground(
                        rounded(
                                Color.rgb(
                                        255,
                                        245,
                                        246
                                ),
                                RED,
                                13
                        )
                );

                card.addView(
                        saved,
                        card.indexOfChild(limit)
                );

                Button remove =
                        secondary(
                                "REMOVE",
                                RED,
                                Color.rgb(
                                        255,
                                        240,
                                        242
                                )
                        );

                card.addView(
                        remove,
                        card.indexOfChild(limit)
                );

                remove.setOnClickListener(
                        z -> {
                            card.removeView(saved);
                            card.removeView(remove);
                        }
                );

                card.removeView(input);
                card.removeView(save);
            });
        });

        content.addView(card);
    }

    // ============================================================
    // STATUS ROW
    // ============================================================

    TextView statusRow(
            LinearLayout parent,
            String icon,
            String name
    ) {

        LinearLayout row =
                new LinearLayout(this);

        row.setGravity(
                Gravity.CENTER_VERTICAL
        );

        row.setPadding(
                0,
                dp(10),
                0,
                dp(3)
        );

        TextView i =
                text(
                        icon,
                        22,
                        true
                );

        i.setGravity(
                Gravity.CENTER
        );

        row.addView(
                i,
                new LinearLayout.LayoutParams(
                        dp(40),
                        dp(58)
                )
        );

        LinearLayout info =
                new LinearLayout(this);

        info.setOrientation(
                LinearLayout.VERTICAL
        );

        info.setGravity(
                Gravity.CENTER_VERTICAL
        );

        TextView n =
                text(
                        name,
                        16,
                        true
                );

        TextView state =
                text(
                        "Checking...",
                        13,
                        true
                );

        state.setTextColor(MUTED);

        info.addView(n);
        info.addView(state);

        row.addView(
                info,
                new LinearLayout.LayoutParams(
                        0,
                        -2,
                        1
                )
        );

        parent.addView(row);

        return state;
    }

    // ============================================================
    // AUTO SERVICE
    // ============================================================

    void showAutoService() {

        base(
                "Auto Service",
                "Service control",
                GREEN
        );

        LinearLayout c =
                card(GREEN);

        c.addView(
                title(
                        "⚡",
                        "Auto Service"
                )
        );

        Switch service =
                new Switch(this);

        service.setText(
                "AUTO SERVICE"
        );

        service.setTextSize(17);

        boolean old =
                prefs.getBoolean(
                        "auto_service",
                        false
                );

        service.setChecked(old);

        c.addView(service);

        TextView status =
                text(
                        old
                                ? "Status: ON"
                                : "Status: OFF",
                        17,
                        true
                );

        status.setTextColor(
                old ? GREEN : MUTED
        );

        c.addView(
                withMargin(
                        status,
                        12,
                        3
                )
        );

        service.setOnCheckedChangeListener(
                (b, checked) -> {

                    prefs.edit()
                            .putBoolean(
                                    "auto_service",
                                    checked
                            )
                            .apply();

                    status.setText(
                            checked
                                    ? "Status: ON"
                                    : "Status: OFF"
                    );

                    status.setTextColor(
                            checked
                                    ? GREEN
                                    : MUTED
                    );
                }
        );

        content.addView(c);

        LinearLayout info =
                card(GREEN);

        info.addView(
                title(
                        "ℹ️",
                        "Service Information"
                )
        );

        info.addView(
                muted(
                        "Required Android permissions must be enabled before using services."
                )
        );

        content.addView(info);
    }

    // ============================================================
