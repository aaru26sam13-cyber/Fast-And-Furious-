    // ============================================================
    // ACCESSIBILITY
    // ============================================================

    boolean accessibilityEnabled() {

        try {

            String enabled =
                    Settings.Secure.getString(
                            getContentResolver(),
                            Settings.Secure.ENABLED_ACCESSIBILITY_SERVICES
                    );

            if (enabled == null)
                return false;

            return enabled.contains(
                    "com.fastandfurious.app"
            );

        } catch (Throwable e) {
            return false;
        }
    }

    void openAccessibility() {

        try {

            startActivity(
                    new Intent(
                            Settings.ACTION_ACCESSIBILITY_SETTINGS
                    )
            );

        } catch (Throwable e) {

            startActivity(
                    new Intent(
                            Settings.ACTION_SETTINGS
                    )
            );
        }
    }

    // ============================================================
    // NOTIFICATION
    // ============================================================

    boolean notificationAllowed() {

        if (Build.VERSION.SDK_INT < 33)
            return true;

        return checkSelfPermission(
                Manifest.permission.POST_NOTIFICATIONS
        ) == PackageManager.PERMISSION_GRANTED;
    }

    void openNotification() {

        try {

            if (
                    Build.VERSION.SDK_INT >= 33 &&
                    !notificationAllowed()
            ) {

                requestPermissions(
                        new String[]{
                                Manifest.permission.POST_NOTIFICATIONS
                        },
                        9001
                );

                return;
            }

            Intent i =
                    new Intent(
                            Settings.ACTION_APP_NOTIFICATION_SETTINGS
                    );

            i.putExtra(
                    Settings.EXTRA_APP_PACKAGE,
                    getPackageName()
            );

            startActivity(i);

        } catch (Throwable e) {

            startActivity(
                    new Intent(
                            Settings.ACTION_SETTINGS
                    )
            );
        }
    }

    // ============================================================
    // BATTERY
    // ============================================================

    boolean batteryUnrestricted() {

        try {

            PowerManager pm =
                    (PowerManager)
                            getSystemService(
                                    POWER_SERVICE
                            );

            return pm != null &&
                    pm.isIgnoringBatteryOptimizations(
                            getPackageName()
                    );

        } catch (Throwable e) {
            return false;
        }
    }

    void openBattery() {

        try {

            Intent i =
                    new Intent(
                            Settings.ACTION_REQUEST_IGNORE_BATTERY_OPTIMIZATIONS
                    );

            i.setData(
                    Uri.parse(
                            "package:" +
                                    getPackageName()
                    )
            );

            startActivity(i);

        } catch (Throwable e) {

            startActivity(
                    new Intent(
                            Settings.ACTION_IGNORE_BATTERY_OPTIMIZATION_SETTINGS
                    )
            );
        }
    }

    // ============================================================
    // SHIZUKU
    // ============================================================

    boolean shizukuConnected() {

        try {
            return Shizuku.pingBinder();
        } catch (Throwable e) {
            return false;
        }
    }

    boolean shizukuAuthorized() {

        try {

            return shizukuConnected() &&
                    Shizuku.checkSelfPermission()
                            == PackageManager.PERMISSION_GRANTED;

        } catch (Throwable e) {
            return false;
        }
    }

    void shizukuAction() {

        try {

            if (!shizukuConnected()) {

                Toast.makeText(
                        this,
                        "Shizuku is not connected. Start Shizuku first.",
                        Toast.LENGTH_LONG
                ).show();

                openShizuku();

                return;
            }

            if (!shizukuAuthorized()) {

                Shizuku.requestPermission(
                        SHIZUKU_PERMISSION_CODE
                );

                return;
            }

            Toast.makeText(
                    this,
                    "Shizuku Connected ✓",
                    Toast.LENGTH_SHORT
            ).show();

            refreshStatuses();

        } catch (Throwable e) {

            Toast.makeText(
                    this,
                    "Shizuku error",
                    Toast.LENGTH_LONG
            ).show();
        }
    }

    void openShizuku() {

        try {

            Intent launch =
                    getPackageManager()
                            .getLaunchIntentForPackage(
                                    "moe.shizuku.privileged.api"
                            );

            if (launch != null) {

                startActivity(launch);

            } else {

                Toast.makeText(
                        this,
                        "Shizuku app is not installed.",
                        Toast.LENGTH_LONG
                ).show();
            }

        } catch (Throwable e) {

            Toast.makeText(
                    this,
                    "Unable to open Shizuku.",
                    Toast.LENGTH_SHORT
            ).show();
        }
    }

    // ============================================================
    // LIVE STATUS
    // ============================================================

    void refreshStatuses() {

        if (accessibilityStatus == null)
            return;

        boolean a =
                accessibilityEnabled();

        accessibilityStatus.setText(
                a ? "● ON" : "● OFF"
        );

        accessibilityStatus.setTextColor(
                a ? GREEN : RED
        );

        boolean n =
                notificationAllowed();

        notificationStatus.setText(
                n
                        ? "● ALLOWED"
                        : "● NOT ALLOWED"
        );

        notificationStatus.setTextColor(
                n ? GREEN : RED
        );

        boolean b =
                batteryUnrestricted();

        batteryStatus.setText(
                b
                        ? "● UNRESTRICTED"
                        : "● RESTRICTED"
        );

        batteryStatus.setTextColor(
                b ? GREEN : RED
        );

        if (!shizukuConnected()) {

            shizukuStatus.setText(
                    "● DISCONNECTED"
            );

            shizukuStatus.setTextColor(
                    RED
            );

        } else if (shizukuAuthorized()) {

            shizukuStatus.setText(
                    "● CONNECTED • AUTHORIZED"
            );

            shizukuStatus.setTextColor(
                    GREEN
            );

        } else {

            shizukuStatus.setText(
                    "● CONNECTED • NOT AUTHORIZED"
            );

            shizukuStatus.setTextColor(
                    ORANGE
            );
        }
    }
}
